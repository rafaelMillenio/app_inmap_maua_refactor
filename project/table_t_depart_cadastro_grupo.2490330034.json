		{
			"eventId": "EVENT_BEFOREADD",
			"pageType": "add",
			"code": "// Concatenando o nome da tabela com o sufixo da página\nif ($values[\"link\"]) {\n    $values[\"link\"] = $values[\"link\"] . \"_list.php\";\n}\nif ($values[\"link_view\"]) {\n    $values[\"link_view\"] = $values[\"link_view\"] . \"_view.php\";\n}\nif ($values[\"link_print\"]) {\n    $values[\"link_print\"] = $values[\"link_print\"] . \"_print.php\";\n}\n\n// * Lógica para salvar o campo uid do depart cadastro no campo fuid_depart_cadastro\n$cadastro = $values[\"cadastro\"]; \n\n$sqlBusca = \"SELECT uid FROM app.t_depart_cadastro WHERE cadastro = '\".$cadastro.\"'\";\n\n$rs = DB::Query($sqlBusca);\n$data = $rs->fetchAssoc();\n\nif($data) {\n  $values[\"fuid_depart_cadastro\"] = $data['uid'];\n}\n\n\nreturn true;"
		},
		{
			"eventId": "EVENT_BEFOREEDIT",
			"pageType": "edit",
			"code": "\n// Concatenando o nome da tabela com o sufixo da página\nif ($values[\"link\"]) {\n    $values[\"link\"] = $values[\"link\"] . \"_list.php\";\n}\nif ($values[\"link_view\"]) {\n    $values[\"link_view\"] = $values[\"link_view\"] . \"_view.php\";\n}\nif ($values[\"link_print\"]) {\n    $values[\"link_print\"] = $values[\"link_print\"] . \"_print.php\";\n}\n\n// * Lógica para salvar o campo uid do depart cadastro no campo fuid_depart_cadastro\n$cadastro = $values[\"cadastro\"]; \n\n$sqlBusca = \"SELECT uid FROM app.t_depart_cadastro WHERE cadastro = '\".$cadastro.\"'\";\n\n$rs = DB::Query($sqlBusca);\n$data = $rs->fetchAssoc();\n\nif($data) {\n  $values[\"fuid_depart_cadastro\"] = $data['uid'];\n}\n\n\nreturn true;"
		}
	],
