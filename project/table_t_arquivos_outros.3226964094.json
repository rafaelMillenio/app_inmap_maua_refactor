	"eventHandlers": [
		{
			"eventId": "EVENT_CUSTOMADD",
			"pageType": "add",
			"code": "\n\t$fileArray = my_json_decode($values[\"files\"]);\n\nfor($i = 0; $i < count($fileArray); $i++)\n{\n\t// ! Area de controle\n\t$ic = $_SESSION[\"ic\"];\n\t$quadra = substr($ic,0,9);\n\tif(empty($ic)){\n\t\t$ic = \"sem_quandra\";\n\t\t$quadra = \"sem_quadra\";\n\t}\n\t$chave = $_SESSION[\"chave\"];\n\n\t// * Encontra o incremento para o arquivo\n\t$sql = \"SELECT COUNT(arquivos) as qtde FROM app.t_arquivos_anexos WHERE ic = '\".$ic.\"' AND tipo = 'outro'\";\n\t$rsExists = DB::query($sql);\n\t$data = $rsExists->fetchAssoc();\n\t$seq = $data[\"qtde\"]+1;\n\n\t// * retrabalha o nome do arquivo\n\t$filename = pathinfo($fileArray[$i][\"usrName\"], PATHINFO_FILENAME);\n\t$extension = pathinfo($fileArray[$i][\"name\"], PATHINFO_EXTENSION);\n\t$filename_final = sanitizarNomeArquivo($ic.\"_\".$filename.\"_\".$seq.\".\".$extension);\n\n\t// * definição de endereços\n\t$tmp_end_arquivo = $fileArray[$i][\"name\"];\n\t$end_fisico = \"/usr/share/nginx/static/storage/ged/gedmaua/outros/\".$quadra.\"/\".$filename_final;\n\t$end_quadra = \"/usr/share/nginx/static/storage/ged/gedmaua/outros/\".$quadra;\n\t$end_url = \"../gedmaua/outros/\".$quadra.\"/\".$filename_final;\n\t\n\t// * cria pasta no storage se n existe e move para lá\n\tif(!file_exists($end_quadra)){\n\t\tmkdir(\"/usr/share/nginx/static/storage/ged/gedmaua/outros/\".$quadra, 0777, true);\n\t}\n\tcopy($tmp_end_arquivo, $end_fisico);\n\tunlink($tmp_end_arquivo);\n\n\n\tDB::exec(\"INSERT INTO app.t_arquivos_anexos (arquivos,nivel,arquivo,ic,chave,end_fisico,end_url,tipo) VALUES('$filename_final',2,1,'$ic','$chave','$end_fisico','$end_url','outro')\");\n}\n;"
		},
