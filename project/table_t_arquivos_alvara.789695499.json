			"customHtml": "<!doctype html>\r\n<html  {$html_attrs}>\r\n  <head>\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>\r\n      {$pagetitle}\r\n    </title>\r\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\r\n    <base href=\"{$projectPath}\">\r\n    <link REL=\"stylesheet\" href=\"styles/default.css?{$wizardBuildKey}\" type=\"text/css\">\r\n    {BEGIN rtlCSS}\r\n      <link REL=\"stylesheet\" href=\"styles/defaultRTL.css?{$wizardBuildKey}\" type=\"text/css\">\r\n    {END rtlCSS}\r\n    {BEGIN styleCSSFiles}\r\n      <link REL=\"stylesheet\" href=\"{$stylepath}\" type=\"text/css\">\r\n    {END styleCSSFiles}\r\n  </head>\r\n  <BODY class=\"{$stylename} function-add\" {$bodyattrs}>\r\n    {BEGIN body}\r\n      {$header}\r\n      <style>\r\n        {$containerCss}\r\n      </style>\r\n      {$locking}\r\n      <DIV class=\"r-small-page\" data-body-align=\"center\" data-body-width=\"standard\">\r\n        {BEGIN top_block}\r\n          <DIV class=\"r-form\" data-location=\"top\" id=\"form_top_{$pageid}\" data-makeup=\"small\" {$form_top} data-pageid=\"{$pageid}\" data-v-width=\"4\" data-v-margin=\"1\">\r\n            <DIV class=\"row\">\r\n              <DIV data-cellId=\"top_c1\" data-pageid=\"{$pageid}\" {$cell_top_c1} class=\"r-ori-vert col-md-12\">\r\n                <h2 data-itemtype=\"add_header\" data-itemid=\"add_header\" {$item_add_header} data-pageid=\"{$pageid}\" >\r\n                  {$pagetitlelabel app_t_arquivos_alvara add}\r\n                </h2>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        {END top_block}\r\n        {BEGIN above-grid_block}\r\n          <DIV class=\"r-form\" data-location=\"above-grid\" id=\"form_above-grid_{$pageid}\" data-makeup=\"small\" {$form_above-grid} data-pageid=\"{$pageid}\" data-v-width=\"4\" data-v-margin=\"1\">\r\n            <DIV class=\"row\">\r\n              <DIV data-cellId=\"above-grid_c1\" data-pageid=\"{$pageid}\" {$cell_above-grid_c1} class=\"r-ori-vert col-md-12\">\r\n                {BEGIN message_block}\r\n                  <DIV data-itemtype=\"add_message\" data-itemid=\"add_message\" {$item_add_message} data-pageid=\"{$pageid}\" class=\"alert {$message_class}\" role=\"alert\">\r\n                    <h5>\r\n                      {$message}\r\n                    </h5>\r\n                  </div>\r\n                {END message_block}\r\n              </div>\r\n            </div>\r\n          </div>\r\n        {END above-grid_block}\r\n        {BEGIN grid_block}\r\n          <TABLE data-body-align=\"center\" data-location=\"grid\" id=\"form_grid_{$pageid}\" data-makeup=\"small\" {$form_grid} data-pageid=\"{$pageid}\" class=\"r-edit-form\" cellpadding=\"0\" cellspacing=\"0\" {$grid_hiddenattr} data-form-width=\"1\" data-v-width=\"4\">\r\n            <tbody>\r\n              <tr {$row_grid_0} >\r\n                {BEGIN cellblock_grid_c3}\r\n                  <TD {$cell_grid_c3} class=\"r-ori-vert\" data-single data-fullwidth data-cellId=\"grid_c3\" data-pageid=\"{$pageid}\" data-v-cell=\"4\">\r\n                    <DIV edit-form-cell class=\"clearfix\">\r\n                      {BEGIN files_fieldblock}\r\n                        <DIV class=\"r-integrated-field form-group clearfix {$fielddispclass_files} r-vertical-field\" data-signal-error-for=\"files{$id}\" data-itemtype=\"integrated_edit_field\" data-itemid=\"integrated_edit_field\" {$item_integrated_edit_field} data-pageid=\"{$pageid}\" data-field=\"files\" data-fieldname=\"files\">\r\n                          <LABEL class=\"r-edit-label control-label\" for=\"{$labelfor_files}\">\r\n                            {BEGIN files_label}\r\n                              {$label app_t_arquivos_alvara files}\r\n                            {END files_label}\r\n                          </label>\r\n                          <DIV class=\"r-edit-field\">\r\n                            {$files_editcontrol}\r\n                          </div>\r\n                          <DIV class=\"r-edit-tooltip\" data-helpfor=\"files\">\r\n                            <DIV class=\"text-muted\">\r\n                              {$tooltip app_t_arquivos_alvara files}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                      {END files_fieldblock}\r\n                  </td>\r\n                {END cellblock_grid_c3}\r\n              </tr>\r\n            </tbody>\r\n          </table>\r\n        {END grid_block}\r\n        {BEGIN below-grid_block}\r\n          <DIV class=\"r-form\" data-location=\"below-grid\" id=\"form_below-grid_{$pageid}\" data-makeup=\"small\" {$form_below-grid} data-pageid=\"{$pageid}\" data-v-width=\"4\" data-v-margin=\"1\">\r\n            <DIV class=\"row\">\r\n              <DIV data-cellId=\"below-grid_c1\" data-pageid=\"{$pageid}\" {$cell_below-grid_c1} class=\"col-md-12\">\r\n                <span data-itemtype=\"add_save\" data-itemid=\"add_save\" {$item_add_save} data-pageid=\"{$pageid}\" data-small data-button-item>\r\n                  <A type=\"button\" title class=\"btn btn-primary\" {$savebutton_attrs}>\r\n                    Salvar\r\n                  </a>\r\n                </span>\r\n                <span data-itemtype=\"add_reset\" data-itemid=\"add_reset\" {$item_add_reset} data-pageid=\"{$pageid}\" data-small data-button-item>\r\n                  <A type=\"button\" title class=\"btn btn-default\" id=\"resetButton{$id}\">\r\n                    Limpar\r\n                  </a>\r\n                </span>\r\n                {BEGIN cancel_button}\r\n                  <span data-itemtype=\"add_cancel\" data-itemid=\"add_cancel\" {$item_add_cancel} data-pageid=\"{$pageid}\" data-small data-button-item>\r\n                    <A type=\"button\" title class=\"btn btn-default\" id=\"cancelButton{$id}\">\r\n                      C