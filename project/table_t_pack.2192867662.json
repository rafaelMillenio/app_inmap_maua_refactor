		{
			"eventId": "EVENT_AFTERDELETE",
			"pageType": "list",
			"code": "\n$delete = \"DELETE FROM app.t_tema_pack WHERE fuid_pack = '\".$deleted_values[\"uid\"].\"'\";\nCustomQuery($delete);\n\n$delete = \"DELETE FROM app.t_pack_layer WHERE fuid_pack = '\".$deleted_values[\"uid\"].\"'\";\nCustomQuery($delete);\n\n$delete = \"DELETE FROM app.t_pack_layer_grupo WHERE fuid_pack = '\".$deleted_values[\"uid\"].\"'\";\nCustomQuery($delete);"
		},
		{
			"eventId": "EVENT_BEFOREDELETE",
			"pageType": "list",
			"code": "\nif (($deleted_values[\"pack\"] == 'Mapas'))\n{\n\techo '<script type=\"text/javascript\"> window.onload = function () { alert(\"Este Pacote não pode ser excluído.\"); }</script>';\n\treturn false;\n}\nelse\n{\n\treturn true;\n};\n"
		},
		{
			"eventId": "EVENT_BEFOREADD",
			"pageType": "add",
			"code": "\n$teste_pack[\"txt\"] = strtolower($values[\"pack\"]);\n\nif((strpos($teste_pack[\"txt\"] == 'mapas')) OR (strpos($teste_pack[\"txt\"] == \"tematicos\")) OR (strpos($teste_pack[\"txt\"] == \"temáticos\")))\n{\n\techo '<script type=\"text/javascript\"> window.onload = function () { alert(\"Os Pacotes \\\"Mapas\\\" e \\\"Temáticos\\\" são reservados pelo sistema.\"); }</script>';\n\treturn false;\n}\nelse\n{\n\treturn true;\n};\n"
		},
		{
			"eventId": "EVENT_BEFOREEDIT",
			"pageType": "edit",
			"code": "\nif(($oldvalues[\"pack\"] == 'Mapas'))\n{\n\techo '<script type=\"text/javascript\"> window.onload = function () { alert(\"Este Pacote não pode ser editado.\"); }</script>';\n\treturn false;\n}\nelse\n{\n\treturn true;\n};"
		},
		{
			"eventId": "EVENT_AFTEREDIT",
			"pageType": "edit",
			"code": "\n$update = \"UPDATE app.t_tema_pack SET pack = '\".$values[\"pack\"].\"' WHERE fuid_pack = '\".$oldvalues[\"uid\"].\"';\";\nCustomQuery($update);\n\n$update = \"UPDATE app.t_pack_layer SET name_pack = '\".$values[\"pack\"].\"' WHERE fuid_pack = '\".$oldvalues[\"uid\"].\"'\";\nCustomQuery($update);\n\n$update = \"UPDATE app.t_pack_layer_grupo SET name_pack = '\".$values[\"pack\"].\"' WHERE fuid_pack = '\".$oldvalues[\"uid\"].\"'\";\nCustomQuery($update);"
		},
